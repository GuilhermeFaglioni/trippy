# Porta da API local; em produção, use a porta definida pelo runtime.
PORT=3000
# URL do Postgres local; em produção, use a URL segura do banco gerenciado.
DATABASE_URL=postgres://trippy:trippy@localhost:54329/trippy
# Região dos serviços AWS; ajuste para a região usada em produção.
AWS_REGION=us-east-1
# Credenciais fictícias aceitas pelo MinIO local; em produção, use uma role IAM.
AWS_ACCESS_KEY_ID=trippy
# Segredo fictício do MinIO local; em produção, não configure chave estática.
AWS_SECRET_ACCESS_KEY=trippy-dev-secret
# Endpoint S3 local; deixe vazio em produção para usar S3 pela AWS.
S3_ENDPOINT=http://localhost:59000
# MinIO local usa path style; em produção, use false para o endereço virtual do S3.
S3_FORCE_PATH_STYLE=true
# Bucket local de fotos e miniaturas; configure o bucket de produção correspondente.
S3_BUCKET_PHOTOS=trippy-photos
# Bucket local de vídeos de recap; configure o bucket de produção correspondente.
S3_BUCKET_VIDEOS=trippy-videos
# Endpoint SQS local; deixe vazio em produção para usar SQS pela AWS.
SQS_ENDPOINT=http://localhost:59324
# Fila local de miniaturas; configure a fila equivalente em produção.
SQS_QUEUE_THUMBS=trippy-thumbs
# Fila local de recaps; configure a fila equivalente em produção.
SQS_QUEUE_RECAP=trippy-recap
# Host SMTP do Mailpit local; em produção, use o SMTP configurado para envio real.
SMTP_HOST=localhost
# Porta SMTP do Mailpit local; em produção, use a porta do provedor SMTP.
SMTP_PORT=51025
# Chave da API Geoapify; opcional localmente, configure como secret de produção ao usar o fornecedor.
GEOAPIFY_API_KEY=
# Chave da API Google Places; opcional localmente, configure como secret de produção ao usar o fornecedor.
GOOGLE_PLACES_API_KEY=
