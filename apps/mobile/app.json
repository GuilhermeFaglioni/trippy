{
  "expo": {
    "name": "Trippy",
    "slug": "trippy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.trippy.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.trippy.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "trippy",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Trippy usa sua localização só quando você toca em Estamos aqui, para sugerir lugares perto de você."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
