{
  "name": "trippy",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @trippy/db migrate",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --project unit && pnpm --filter @trippy/mobile test && pnpm --filter @trippy/mobile test:expo-mcp && pnpm --filter @trippy/mobile test:lint-rule",
    "test:integration": "vitest run --project integration",
    "bootstrap": "pnpm --filter @trippy/dev-env bootstrap"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
