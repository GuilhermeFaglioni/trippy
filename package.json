{
  "name": "trippy",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @trippy/db migrate",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --project unit && pnpm --filter @trippy/mobile test && pnpm --filter @trippy/mobile test:expo-mcp",
    "test:integration": "vitest run --project integration",
    "bootstrap": "pnpm --filter @trippy/dev-env bootstrap"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
